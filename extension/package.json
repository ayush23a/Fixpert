{
  "name": "fixpert",
  "displayName": "Fixpert",
  "publisher": "AyushAman",
  "description": "Fixpert explains errors from your code and terminal using AI, helping you quickly understand root causes with their confidence scores and apply fixes inside VS Code.",
  "version": "0.1.1",
  "icon": "image/analysis.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayush23a/Fixpert"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
  "Programming Languages",
  "Debuggers",
  "Other"
  ],

  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "errorExplainer.analyzeError",
        "title": "Explain with AI"
      },
      {
        "command": "errorExplainer.showHistory",
        "title": "Show Explanation History"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "errorExplainer.analyzeError",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ],
      "terminal/context": [
        {
          "command": "errorExplainer.analyzeError",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Fixpert Settings",
      "properties": {
        "fixpert.backendUrl": {
          "type": "string",
          "default": "https://fixpert-4qyn.onrender.com",
          "description": "URL of the AI Analysis Backend",
          "scope": "application",
          "markdownDescription": "**Internal setting. Do not modify.**"
        },
        "fixpert.enableHistory": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in to save error explanation history to the database."
        },
        "fixpert.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Google Gemini API Key. Provide this key to use the AI analysis features."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
